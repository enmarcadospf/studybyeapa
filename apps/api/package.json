{
  "name": "@academia/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --project tsconfig.json --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts",
